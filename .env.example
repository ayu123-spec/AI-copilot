# Copy to .env and adjust. NEVER commit real secrets.
PROJECT_NAME=Enterprise AI Knowledge Copilot
DATABASE_URL=postgresql+asyncpg://copilot:copilot@db:5432/copilot
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO

# Phase 1: embeddings + vector store
EMBEDDING_BACKEND=local            # local | openai | fake
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OPENAI_API_KEY=sk-...            # only if EMBEDDING_BACKEND=openai
# QDRANT_URL=http://localhost:6333 # if unset, an embedded on-disk store is used
QDRANT_COLLECTION=documents
CHUNK_STRATEGY=recursive           # recursive | fixed | semantic | parent_child
