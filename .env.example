# Copy to .env and adjust. NEVER commit real secrets (.env is gitignored).
PROJECT_NAME=Enterprise AI Knowledge Copilot
# Local dev uses SQLite; Docker/Postgres override this in docker-compose.
DATABASE_URL=sqlite+aiosqlite:///./copilot.db
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
LOG_LEVEL=INFO

# --- Answer generation (the brain) ---
LLM_BACKEND=anthropic                 # fake | anthropic | openai
LLM_MODEL=claude-haiku-4-5-20251001   # Haiku = cheapest; or claude-sonnet-4-6
ANTHROPIC_API_KEY=sk-ant-...          # paste your key (pip install anthropic)

# --- Retrieval ---
EMBEDDING_BACKEND=fake                # fake (offline) | local (semantic) | openai
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANK_BACKEND=fake                   # fake | cross_encoder
QDRANT_COLLECTION=documents
CHUNK_STRATEGY=recursive
